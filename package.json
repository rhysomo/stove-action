{
  "name": "stove-actions",
  "version": "0.1.0",
  "description": "A GitHub Action for uploading game builds to STOVE Studio.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ncc build src/main.ts -o dist/main --minify && ncc build src/post.ts -o dist/post --minify",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-actions",
    "stove",
    "smilegate",
    "game-deploy",
    "stove-store"
  ],
  "author": "insd47",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "24.x"
  }
}
