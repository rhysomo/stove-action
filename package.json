{
  "name": "stove-actions",
  "version": "0.1.0",
  "description": "GitHub Actions for deploying game builds to the STOVE Store.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "keywords": [
    "github-actions",
    "stove",
    "smilegate",
    "game-deploy",
    "stove-store"
  ],
  "author": "insd47",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "24.x"
  }
}
